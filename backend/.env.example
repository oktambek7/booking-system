DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5432/booking
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
JWT_EXPIRE_MINUTES=15
BUSINESS_TIMEZONE=Asia/Tashkent
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TMDB_READ_TOKEN=
TMDB_REGION=UZ
TMDB_MAX_PAGES=5
TMDB_SYNC_INTERVAL_HOURS=24
SMS_MODE=mock
SMS_API_URL=https://notify.eskiz.uz/api
SMS_EMAIL=
SMS_PASSWORD=
SMS_SENDER=4546
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
BREVO_API_KEY=
BREVO_FROM=
OTP_SECRET=replace-with-a-long-random-secret
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
# json (default in production) or text (default otherwise)
LOG_FORMAT=
RATE_LIMIT_ENABLED=true
REFRESH_TOKEN_DAYS=30
REFRESH_FAMILY_MAX_DAYS=90
REFRESH_REUSE_GRACE_SECONDS=10
MAX_PENDING_HOLDS_PER_USER=3
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
LIVE_UPDATES_ENABLED=true
LIVE_MAX_STREAMS_PER_IP=10
LIVE_MAX_STREAMS=2000
REFUND_FULL_HOURS=24
REFUND_PARTIAL_HOURS=2
REFUND_PARTIAL_PERCENT=50
MAX_PENDING_SEATS_PER_SCREENING=8
# Upgrade the database schema (Alembic) when the API starts. Set false once `python -m app.migrate` is a release step.
AUTO_MIGRATE=true
# Run the notification/catalogue loops inside the API. Set false when a separate `python -m app.worker` runs them.
RUN_BACKGROUND_JOBS=true
NOTIFICATION_MAX_ATTEMPTS=8
# Header with the real caller address behind a proxy (Render: cf-connecting-ip). Leave empty locally.
CLIENT_IP_HEADER=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NICKNAME=admin
# Temporary only: promotes this existing nickname to admin on startup. Remove
# it from the deployment after the account has received access.
OPERATOR_BOOTSTRAP_NICKNAME=
